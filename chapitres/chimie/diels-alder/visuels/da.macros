% Macros communes aux visuels du chapitre Diels-Alder (incluses par \input{da.macros}).
\newcommand{\R}{0.8}
% \hexa{p}{(x,y)} : sommets p1…p6 d'un hexagone (1 en haut, sens trigo), centre pc.
%   Numérotation du produit : 1-2-3-4 issus du diène, 5-6 du diénophile.
\newcommand{\hexa}[2]{\coordinate (#1c) at #2;
  \foreach \i/\a in {1/90,2/150,3/210,4/270,5/330,6/30}{\coordinate (#1\i) at ($#2+(\a:\R)$);}}
% \cyclohexene{p}{(x,y)}{couleur des liaisons créées}
\newcommand{\cyclohexene}[3]{\hexa{#1}{#2}
  \draw (#11) -- (#12) -- (#13) -- (#14);
  \dbl{#12}{#13}{90}
  \draw[#3] (#14) -- (#15) (#16) -- (#11);
  \draw (#15) -- (#16);}
% \reactifs[écart]{p}{(x,y)} : diène s-cis (p1…p4) et diénophile (p5, p6) en position d'approche.
% Argument optionnel : demi-écart entre les deux réactifs (défaut 0.32).
\newcommand{\reactifs}[3][0.32]{\hexa{#2h}{#3}
  \foreach \i in {1,2,3,4}{\coordinate (#2\i) at ($(#2h\i)+(-#1,0)$);}
  \foreach \i in {5,6}{\coordinate (#2\i) at ($(#2h\i)+(#1,0)$);}
  \draw (#21) -- (#22) -- (#23) -- (#24) (#25) -- (#26);
  \dbl{#21}{#22}{90} \dbl{#23}{#24}{90} \dbl{#25}{#26}{90}}
% Substituants : \sP (simple), \sC (coin), \sH (hachuré){atome}{angle}{étiquette}
\newcommand{\etiq}[3]{\pgfmathsetmacro{\an}{#2+180}
  \node[anchor=\an, inner sep=1.2pt, font=\small] at ($(#1)+(#2:0.58)$) {#3};}
\newcommand{\sP}[3]{\draw (#1) -- ($(#1)+(#2:0.58)$); \etiq{#1}{#2}{#3}}
\newcommand{\sC}[3]{\coin{#1}{$(#1)+(#2:0.58)$} \etiq{#1}{#2}{#3}}
\newcommand{\sH}[3]{\hach{#1}{$(#1)+(#2:0.58)$} \etiq{#1}{#2}{#3}}
% Orbitale p : \lobe{(x,y)}{coefficient}{échelle}. Lobe du haut noir si coefficient > 0.
\newcommand{\lobe}[3]{\pgfmathsetmacro{\h}{abs(#2)*#3}\pgfmathsetmacro{\w}{0.42*\h}
  \pgfmathparse{#2>0 ? 1 : 0}\ifnum\pgfmathresult=1
    \filldraw[fill=black, line width=0.5pt] #1 .. controls +(-\w,\h) and +(\w,\h) .. #1;
    \filldraw[fill=white, line width=0.5pt] #1 .. controls +(-\w,-\h) and +(\w,-\h) .. #1;
  \else
    \filldraw[fill=white, line width=0.5pt] #1 .. controls +(-\w,\h) and +(\w,\h) .. #1;
    \filldraw[fill=black, line width=0.5pt] #1 .. controls +(-\w,-\h) and +(\w,-\h) .. #1;
  \fi}
